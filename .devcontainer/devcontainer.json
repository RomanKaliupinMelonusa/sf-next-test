{
    "name": "Template Retail App",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
    "hostRequirements": {
        "memory": "12gb"
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "postCreateCommand": "sudo corepack enable && pnpm install",
    "forwardPorts": [5173, 6006, 24678],
    "portsAttributes": {
        "5173": { "label": "Dev Server", "onAutoForward": "notify" },
        "6006": { "label": "Storybook", "onAutoForward": "notify" },
        "24678": { "label": "Vite HMR", "onAutoForward": "silent" }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "dbaeumer.vscode-eslint",
                "bradlc.vscode-tailwindcss",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "editor.formatOnSave": true
            }
        }
    }
}
